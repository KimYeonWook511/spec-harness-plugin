{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/run/scripts/hooks/block_early_merge.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/run/scripts/hooks/log_progress.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^spec-harness:(developer|reviewer|committer|recorder|finalizer)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/run/scripts/hooks/log_stop.sh\""
          }
        ]
      }
    ]
  }
}
